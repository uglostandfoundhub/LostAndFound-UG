@page "/items"
@using LostAndFound.Shared.Dtos.Items
@inject ApiClient Api
@inject LookupsCache Lookups
@inject NavigationManager Nav

<PageTitle>Items</PageTitle>

<h3>Lost &amp; Found Items</h3>

<div class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <input class="form-control" placeholder="Search title or description..." @bind="searchTerm" @bind:event="oninput" />
    </div>
    <div class="col-auto">
        <select class="form-select" @bind="typeFilter">
            <option value="">Any type</option>
            <option value="0">Lost</option>
            <option value="1">Found</option>
        </select>
    </div>
    <div class="col-auto">
        <select class="form-select" @bind="categoryFilter">
            <option value="">Any category</option>
            @foreach (var c in categories) { <option value="@c.Id">@c.Name</option> }
        </select>
    </div>
    <div class="col-auto">
        <select class="form-select" @bind="locationFilter">
            <option value="">Any location</option>
            @foreach (var l in locations) { <option value="@l.Id">@l.Name</option> }
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-primary" @onclick="Load">Search</button></div>
</div>

@if (loading)
{
    <p>Loading...</p>
}
else if (items is null)
{
    <div class="alert alert-warning">Could not load items. Make sure the API is running.</div>
}
else if (items.Items.Count == 0)
{
    <p>No items match your search.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr><th></th><th>Title</th><th>Type</th><th>Status</th><th>Category</th><th>Location</th><th>Reported</th></tr>
        </thead>
        <tbody>
        @foreach (var it in items.Items)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(Api.GetImageUrl(it.PrimaryImage)))
                    {
                        <img src="@Api.GetImageUrl(it.PrimaryImage)" class="img-thumbnail" style="width:64px" />
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td><a href="/items/@it.Id">@it.Title</a></td>
                <td>@it.Type</td>
                <td>@it.Status</td>
                <td>@Lookups.CategoryName(it.CategoryId)</td>
                <td>@Lookups.LocationName(it.LocationId)</td>
                <td>@it.DateOccurred.ToString("yyyy-MM-dd")</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private PagedResult<ItemDto>? items;
    private bool loading = true;
    private string searchTerm = string.Empty;
    private string typeFilter = string.Empty;
    private string categoryFilter = string.Empty;
    private string locationFilter = string.Empty;
    private IReadOnlyList<CategoryDto> categories = Array.Empty<CategoryDto>();
    private IReadOnlyList<LocationDto> locations = Array.Empty<LocationDto>();

    protected override async Task OnInitializedAsync()
    {
        categories = await Lookups.GetCategoriesAsync();
        locations = await Lookups.GetLocationsAsync();
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        var p = new ItemSearchParameters
        {
            SearchTerm = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm,
            Type = string.IsNullOrEmpty(typeFilter) ? null : (ItemType?)int.Parse(typeFilter),
            CategoryId = string.IsNullOrEmpty(categoryFilter) ? null : int.Parse(categoryFilter),
            LocationId = string.IsNullOrEmpty(locationFilter) ? null : int.Parse(locationFilter),
            PageSize = 50
        };
        items = await Api.GetItemsAsync(p);
        loading = false;
    }
}
